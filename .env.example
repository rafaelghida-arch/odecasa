# Ô de Casa — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure também na Vercel.
# Nunca coloque valores reais neste arquivo.

# URL pública do app (usada em links). Ex.: https://odecasa.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). A chave anon/publishable é pública e protegida pela RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Chave privilegiada (service_role/secret). SOMENTE no servidor; nunca com prefixo NEXT_PUBLIC_.
# Usada só para os limites de uso compartilhados entre instâncias. Sem ela, o limite fica em memória.
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de IA. Sem nenhuma chave, o app roda em MODO DEMONSTRAÇÃO (respostas fixas, identificadas).
# Padrão: Google Gemini (plano gratuito do Google AI Studio). Alternativas pagas: openai, anthropic.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Opcional: modelo Gemini com visão (padrão: gemini-2.5-flash)
GEMINI_MODEL=
# Alternativa paga: OpenAI
OPENAI_API_KEY=
# Opcional: modelo com visão (padrão: gpt-5.4-mini)
OPENAI_MODEL=
# Alternativa: Anthropic
ANTHROPIC_API_KEY=
# Opcional: modelo multimodal usado (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=
# Opcional: força o modo demonstração mesmo com chave (true/false)
AI_DEMO_MODE=false

# Limites de mensagens para a IA por hora
RATE_LIMIT_GUEST_PER_HOUR=12
RATE_LIMIT_USER_PER_HOUR=60
# Sal para gerar o identificador anônimo dos visitantes (texto aleatório longo)
RATE_LIMIT_SALT=troque-por-um-texto-aleatorio-longo
